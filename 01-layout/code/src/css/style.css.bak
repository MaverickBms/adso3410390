
/* =========================================================
   PIT STOP CAFÉ BAR
   style.css
   Fase 2: diseño visual y responsive
========================================================= */

/* =========================================================
   1. VARIABLES Y CONFIGURACIÓN GLOBAL
========================================================= */

:root {
    color-scheme: dark;

    --color-background: #090909;
    --color-background-alt: #111111;
    --color-surface: #191919;
    --color-surface-light: #303030;
    --color-border: #383838;

    --color-primary: #f20d16;
    --color-primary-hover: #c90009;
    --color-white: #f5f5f5;
    --color-muted: #999999;
    --color-black: #000000;

    --font-heading: "Arial Narrow", "Roboto Condensed",
        "Helvetica Neue", sans-serif;
    --font-body: Arial, Helvetica, sans-serif;

    --container-width: 1440px;
    --page-gutter: clamp(20px, 5.5vw, 84px);

    --header-height: 78px;

    --transition-fast: 180ms ease;
    --transition-normal: 280ms ease;

    --radius-small: 3px;
    --radius-medium: 7px;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header-height) + 20px);
}

body {
    min-width: 320px;
    margin: 0;
    overflow-x: clip;
    background: var(--color-background);
    color: var(--color-white);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

body,
button,
input,
textarea,
select {
    font-family: var(--font-body);
}

img {
    display: block;
    max-width: 100%;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    color: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

ul,
ol {
    margin: 0;
    padding: 0;
    list-style: none;
}

figure {
    margin: 0;
}

p,
h1,
h2,
h3,
blockquote,
dl,
dd {
    margin-top: 0;
}

h1,
h2,
h3 {
    margin-bottom: 0;
}

::selection {
    background: var(--color-primary);
    color: var(--color-white);
}

section[id],
footer[id],
div[id] {
    scroll-margin-top: calc(var(--header-height) + 20px);
}

.section-dark {
    background: var(--color-background);
}

.section-container {
    width: min(
        var(--container-width),
        calc(100% - var(--page-gutter) * 2)
    );
    margin-inline: auto;
}

.text-accent {
    color: var(--color-primary);
}

.status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    flex: 0 0 6px;
    border-radius: 50%;
    background: var(--color-primary);
    vertical-align: middle;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 12px;
    color: var(--color-muted);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
}

.section-title {
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(30px, 3.2vw, 48px);
    font-stretch: condensed;
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
}

.outlined-text {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-white);
}

.skip-link {
    position: absolute;
    z-index: 1000;
    top: 10px;
    left: 10px;
    padding: 10px 14px;
    transform: translateY(-160%);
    background: var(--color-primary);
    color: var(--color-white);
}

.skip-link:focus {
    transform: translateY(0);
}

/* =========================================================
   2. BOTONES Y ENLACES
========================================================= */

.button {
    display: inline-flex;
    min-height: 37px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 9px 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-small);
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.035em;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
    transition:
        background var(--transition-fast),
        border-color var(--transition-fast),
        color var(--transition-fast),
        transform var(--transition-fast);
}

.button:hover {
    transform: translateY(-2px);
}

.button--primary {
    background: var(--color-primary);
    color: var(--color-white);
}

.button--primary:hover {
    background: var(--color-primary-hover);
}

.button--outline {
    border-color: #686868;
    background: transparent;
    color: var(--color-white);
}

.button--outline:hover {
    border-color: var(--color-white);
    background: rgba(255, 255, 255, 0.06);
}

.button--light {
    background: var(--color-white);
    color: var(--color-black);
}

.button--light:hover {
    background: #d9d9d9;
}

.text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.text-link:hover {
    color: var(--color-white);
}

/* =========================================================
   3. ENCABEZADO Y NAVEGACIÓN
========================================================= */

.site-header {
    position: relative;
    z-index: 100;
    width: 100%;
    height: var(--header-height);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    background: #080808;
}

.header-container {
    display: flex;
    width: min(
        1600px,
        calc(100% - var(--page-gutter) * 1.15)
    );
    height: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-inline: auto;
}

.brand-logo {
    display: inline-flex;
    width: 145px;
    flex: 0 0 145px;
    align-items: center;
}

.brand-logo__image {
    width: 100%;
    height: auto;
    max-height: 56px;
    object-fit: contain;
    object-position: left center;
}

.main-navigation {
    display: flex;
    align-items: center;
    margin-left: auto;
}

.main-navigation__list {
    display: flex;
    align-items: center;
    gap: clamp(17px, 2.3vw, 34px);
}

.main-navigation__link {
    position: relative;
    display: inline-block;
    padding-block: 10px;
    color: #888888;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
}

.main-navigation__link::after {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--color-primary);
    content: "";
    transition: transform var(--transition-fast);
}

.main-navigation__link:hover,
.main-navigation__link[aria-current="page"] {
    color: var(--color-white);
}

.main-navigation__link:hover::after,
.main-navigation__link[aria-current="page"]::after {
    transform: scaleX(1);
}

.header-reservation {
    min-height: 32px;
    padding: 8px 16px;
    border-radius: 30px;
}

.menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 7px;
    border: 0;
    background: transparent;
}

.menu-toggle__line {
    display: block;
    width: 21px;
    height: 2px;
    background: var(--color-white);
    transition:
        transform var(--transition-fast),
        opacity var(--transition-fast);
}

.menu-toggle.is-active .menu-toggle__line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
}

.menu-toggle.is-active .menu-toggle__line:nth-child(2) {
    opacity: 0;
}

.menu-toggle.is-active .menu-toggle__line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
}

body.menu-open {
    overflow: hidden;
}

/* =========================================================
   3b. ANIMACIONES DE APARICIÓN (REVEAL)
========================================================= */

.reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
        opacity 600ms ease,
        transform 600ms ease;
    will-change: opacity, transform;
}

.reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
    .reveal {
        opacity: 1;
        transform: none;
        transition: none;
    }
}

/* =========================================================
   4. HERO / PORTADA
========================================================= */

.hero {
    position: relative;
    display: grid;
    min-height: min(690px, calc(100svh - var(--header-height)));
    grid-template-columns: minmax(340px, 0.78fr) minmax(0, 1.22fr);
    border-bottom: 1px solid #222222;
}

.hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 65px 0 70px var(--page-gutter);
}

.hero__eyebrow {
    margin-bottom: 20px;
    font-size: 9px;
}

.hero__title {
    max-width: 600px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(42px, 5.2vw, 79px);
    font-weight: 950;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-transform: uppercase;
}

.hero__title .text-accent {
    display: block;
}

.hero__description {
    max-width: 330px;
    margin: 17px 0 0;
    color: #c2c2c2;
    font-size: 12px;
    line-height: 1.55;
}

.hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 23px;
}

.hero__actions .button {
    border-radius: 30px;
}

.race-status {
    display: flex;
    align-items: flex-start;
    gap: clamp(20px, 2.8vw, 42px);
    margin-top: 42px;
}

.race-status__item {
    display: flex;
    min-width: 54px;
    flex-direction: column;
    gap: 3px;
}

.race-status__value {
    font-family: var(--font-heading);
    font-size: 27px;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
}

.race-status__label {
    color: #858585;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-transform: uppercase;
}

.race-status__item--live {
    align-items: flex-start;
}

.live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 7px;
    border: 1px solid #4a4a4a;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
}

.live-indicator .status-dot {
    width: 5px;
    height: 5px;
    flex-basis: 5px;
}

.hero__microcopy {
    margin: 19px 0 0;
    color: #6d6d6d;
    font-size: 8px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.hero__visual {
    position: relative;
    min-width: 0;
    min-height: 480px;
    overflow: hidden;
    background: #151515;
}

.hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
}

.hero__image-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            180deg,
            rgba(0, 0, 0, 0.13),
            transparent 42%,
            rgba(0, 0, 0, 0.62)
        );
    pointer-events: none;
}

.hero__image-top {
    position: absolute;
    top: 22px;
    left: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
}

.race-tag {
    padding: 5px 8px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.race-tag--outline {
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.35);
}

.hero__image-bottom {
    position: absolute;
    right: 24px;
    bottom: 24px;
    left: 24px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
}

.finish-label {
    display: flex;
    flex-direction: column;
    padding: 5px 10px;
    background: var(--color-white);
    color: var(--color-black);
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
}

.finish-label span {
    margin-top: 3px;
    font-size: 8px;
    letter-spacing: 0.08em;
}

.lap-counter {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
}

.lap-counter__value {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3vw, 42px);
    font-weight: 950;
    letter-spacing: -0.045em;
    line-height: 1;
}

.lap-counter__label {
    color: #d1d1d1;
    font-size: 8px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
}

.hero__progress {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 0;
    left: 0;
    height: 3px;
    background: #272727;
}

.hero__progress-value {
    display: block;
    width: 41%;
    height: 100%;
    background: var(--color-primary);
}

/* =========================================================
   5. PRESENTACIÓN DE LA MARCA
========================================================= */

.brand-intro {
    display: flex;
    min-height: 310px;
    align-items: center;
    justify-content: center;
    padding: 76px var(--page-gutter) 72px;
    border-bottom: 1px solid #333333;
    text-align: center;
}

.brand-intro__inner {
    width: min(820px, 100%);
    margin-inline: auto;
}

.brand-intro__eyebrow {
    justify-content: center;
    margin-bottom: 19px;
}

.brand-intro__title {
    font-size: clamp(34px, 4.1vw, 56px);
    line-height: 1.02;
}

.brand-intro__title .outlined-text {
    margin-top: 5px;
}

.brand-intro__description {
    max-width: 570px;
    margin: 22px auto 0;
    color: #a3a3a3;
    font-size: 12px;
    line-height: 1.7;
}

.race-separator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
    color: #aaaaaa;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.race-separator__line {
    width: clamp(16px, 3vw, 45px);
    height: 1px;
    background: #525252;
}

.race-separator__status {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-primary);
}

/* =========================================================
   6. CABECERAS DE SECCIÓN
========================================================= */

.section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 27px;
}

.section-header__main {
    min-width: 0;
}

.section-header .eyebrow {
    margin-bottom: 9px;
}

.section-header__description {
    max-width: 300px;
    margin: 0 0 3px;
    color: #8e8e8e;
    font-size: 10px;
    line-height: 1.6;
    text-align: right;
}

/* =========================================================
   7. NUESTRO MENÚ
========================================================= */

.menu-section {
    padding-block: 77px 82px;
}

.menu-grid {
    display: grid;
    min-width: 0;
    grid-template-columns: 1.25fr 0.8fr 0.95fr;
    grid-template-rows: minmax(150px, 1fr) minmax(150px, 1fr);
    gap: 12px;
}

.menu-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-medium);
    background: var(--color-surface-light);
}

.menu-card--featured {
    grid-column: 1;
    grid-row: 1 / 3;
    min-height: 390px;
}

.menu-card--beverages {
    grid-column: 2;
    grid-row: 1;
}

.menu-card--food {
    grid-column: 2;
    grid-row: 2;
}

.menu-card--combo {
    display: flex;
    grid-column: 3;
    grid-row: 1 / 3;
    flex-direction: column;
}

.menu-card__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    overflow: hidden;
    color: var(--color-white);
}

.menu-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
}

.menu-card:hover .menu-card__image {
    transform: scale(1.045);
}

.menu-card--featured .menu-card__image {
    object-position: center 35%;
}

.menu-card--beverages .menu-card__image,
.menu-card--food .menu-card__image {
    object-position: center;
}

.menu-card--featured .menu-card__link::after,
.menu-card--beverages .menu-card__link::after,
.menu-card--food .menu-card__link::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.23),
        transparent 30%,
        rgba(0, 0, 0, 0.88)
    );
    content: "";
}

.menu-card__number {
    position: absolute;
    z-index: 2;
    top: 13px;
    left: 13px;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 950;
    letter-spacing: -0.04em;
    line-height: 1;
}

.menu-card__category {
    position: absolute;
    z-index: 2;
    top: 16px;
    right: 12px;
    max-width: calc(100% - 85px);
    color: #d5d5d5;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-align: right;
    text-transform: uppercase;
}

.menu-card__content {
    position: absolute;
    z-index: 2;
    right: 16px;
    bottom: 15px;
    left: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
}

.menu-card__title {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(21px, 2vw, 31px);
    font-weight: 950;
    letter-spacing: -0.035em;
    line-height: 1;
    text-transform: uppercase;
}

.menu-card__description {
    display: block;
    max-width: 260px;
    color: #d0d0d0;
    font-size: 10px;
    line-height: 1.45;
}

.menu-card__content .button {
    margin-top: 6px;
}

.menu-card--beverages .menu-card__number,
.menu-card--food .menu-card__number {
    top: 10px;
    left: 10px;
    font-size: 21px;
}

.menu-card--beverages .menu-card__category,
.menu-card--food .menu-card__category {
    top: 13px;
    right: 9px;
    font-size: 7px;
}

.menu-card--beverages .menu-card__content,
.menu-card--food .menu-card__content {
    right: 10px;
    bottom: 10px;
    left: 10px;
    gap: 4px;
}

.menu-card--beverages .menu-card__title,
.menu-card--food .menu-card__title {
    font-size: clamp(18px, 1.6vw, 24px);
}

.menu-card--beverages .menu-card__description,
.menu-card--food .menu-card__description {
    font-size: 9px;
}

.menu-card__combo-header {
    position: relative;
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 13px;
    background: #303030;
}

.menu-card--combo .menu-card__number,
.menu-card--combo .menu-card__category {
    position: static;
}

.menu-card--combo .menu-card__number {
    font-size: 22px;
}

.menu-card__combo-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 22px 16px;
    background: #303030;
}

.menu-card__badge {
    display: inline-block;
    margin-top: 8px;
    padding: 4px 7px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 8px;
    font-weight: 800;
    text-transform: uppercase;
}

.menu-card--combo .menu-card__description {
    margin: 11px 0 15px;
    font-size: 12px;
    line-height: 1.5;
}

.menu-card--combo .button {
    margin-top: 3px;
}

/* =========================================================
   8. RACE WEEKEND / EVENTOS
========================================================= */

.events-section {
    padding-block: 82px 73px;
    border-bottom: 1px solid #343434;
    background: #111111;
}

.events-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(150px, 0.65fr);
    grid-template-rows: repeat(2, minmax(130px, 1fr));
    gap: 12px;
}

.event-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: #2c2c2c;
}

.event-card--featured {
    grid-column: 1;
    grid-row: 1 / 3;
    min-height: 310px;
}

.event-card--secondary {
    min-height: 145px;
}

.event-card__link {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    flex-direction: column;
    justify-content: flex-end;
    color: var(--color-white);
}

.event-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
}

.event-card:hover .event-card__image {
    transform: scale(1.04);
}

.event-card__link::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.05) 15%,
        rgba(0, 0, 0, 0.05) 35%,
        rgba(0, 0, 0, 0.82) 100%
    );
    content: "";
}

.event-card__tag {
    position: absolute;
    z-index: 2;
    top: 13px;
    left: 13px;
    padding: 5px 8px;
    background: var(--color-primary);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.event-card__tag--outline {
    left: auto;
    right: 13px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    background: rgba(0, 0, 0, 0.45);
}

.event-card__information {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    gap: 13px;
    padding: 15px;
}

.event-card__date {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 47px;
    padding: 5px 7px;
    background: var(--color-white);
    color: var(--color-black);
}

.event-card__day {
    font-family: var(--font-heading);
    font-size: 35px;
    font-weight: 950;
    letter-spacing: -0.06em;
    line-height: 0.95;
}

.event-card__month {
    margin-top: 4px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.08em;
}

.event-card__details {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 4px;
}

.event-card__location {
    color: #cccccc;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.event-card__title {
    display: block;
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 950;
    line-height: 1.1;
    text-transform: uppercase;
}

.event-card__description {
    display: block;
    color: #d2d2d2;
    font-size: 9px;
    line-height: 1.4;
}

.event-card--featured .event-card__title {
    font-size: clamp(16px, 1.8vw, 25px);
}

.event-card--featured .button {
    flex: 0 0 auto;
    min-height: 31px;
    padding: 7px 10px;
    font-size: 9px;
}

.event-card--secondary .event-card__information {
    align-items: center;
    gap: 10px;
    padding: 10px;
}

.event-card--secondary .event-card__date {
    min-width: 48px;
    padding: 8px 5px;
}

.event-card--secondary .event-card__day {
    font-size: 30px;
}

.event-card--secondary .event-card__title {
    font-size: 13px;
}

.events-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 18px;
    padding: 13px 17px;
    border: 1px solid #373737;
    border-radius: var(--radius-small);
}

.events-footer__note {
    margin: 0;
    color: #929292;
    font-size: 9px;
}

/* =========================================================
   9. PRECISION / SPEED / PASSION / CRAFT
========================================================= */

.experience-section {
    padding-block: 82px 86px;
}

.experience-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(45px, 8vw, 120px);
}

.experience__content {
    min-width: 0;
}

.experience__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    margin-top: 20px;
    font-family: var(--font-heading);
    font-size: clamp(38px, 4.4vw, 62px);
    font-weight: 950;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-transform: uppercase;
}

.experience__title .outlined-text {
    -webkit-text-stroke-width: 1px;
}

.experience__description {
    max-width: 360px;
    margin: 24px 0 0;
    color: #b0b0b0;
    font-size: 12px;
    line-height: 1.65;
}

.coffee-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 30px;
}

.coffee-spec {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.coffee-spec__value {
    font-family: var(--font-heading);
    font-size: 27px;
    font-weight: 950;
    letter-spacing: -0.035em;
    line-height: 1;
}

.coffee-spec__label {
    color: #8e8e8e;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.experience__brand-mark {
    width: min(180px, 55%);
    margin-top: 28px;
}

.experience__brand-mark img {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: left center;
}

.experience__visual {
    position: relative;
    display: grid;
    min-height: 470px;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: start;
    gap: 12px;
    padding-bottom: 25px;
}

.experience__image {
    position: relative;
    overflow: hidden;
    background: #202020;
}

.experience__image img {
    width: 100%;
    height: 100%;
    min-height: 310px;
    object-fit: cover;
}

.experience__image--machine {
    margin-top: 0;
}

.experience__image--machine img {
    aspect-ratio: 0.77;
}

.experience__image--barista {
    margin-top: 105px;
}

.experience__image--barista img {
    aspect-ratio: 0.72;
}

.experience-quote {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    width: min(260px, 66%);
    padding: 16px;
    background: var(--color-primary);
}

.experience-quote__label {
    margin-bottom: 7px;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 950;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.experience-quote__text {
    margin-bottom: 8px;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 900;
    line-height: 1.25;
}

.experience-quote__author {
    margin: 0;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

/* =========================================================
   10. UBICACIÓN Y VISÍTANOS
========================================================= */

.location-section {
    padding-block: 0 76px;
}

.location-card {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    overflow: hidden;
    border: 1px solid #343434;
    border-radius: var(--radius-medium);
    background: #111111;
}

.location-map {
    position: relative;
    min-width: 0;
    min-height: 330px;
    overflow: hidden;
    background: #dfe6df;
}

.location-map__link {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
}

.location-map__image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
}

.location-map__label,
.location-map__status {
    position: absolute;
    z-index: 2;
    padding: 7px 10px;
    background: rgba(10, 10, 10, 0.88);
    color: var(--color-white);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.location-map__label {
    top: 13px;
    left: 13px;
}

.location-map__status {
    right: 13px;
    bottom: 13px;
    color: #ff5555;
}

.location-details {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(25px, 4vw, 50px);
}

.location-details .eyebrow {
    margin-bottom: 12px;
}

.location-details .section-title {
    font-size: clamp(30px, 3vw, 42px);
}

.location-details__intro {
    margin: 10px 0 20px;
    color: #a4a4a4;
    font-size: 11px;
}

.location-information {
    display: grid;
    width: 100%;
    gap: 13px;
    margin: 0;
}

.location-information__item {
    padding-top: 12px;
    border-top: 1px solid #333333;
}

.location-information dt {
    margin-bottom: 4px;
    color: var(--color-white);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.location-information dd {
    margin: 0;
    color: #a5a5a5;
    font-size: 10px;
    line-height: 1.6;
}

.location-information dd a {
    color: var(--color-white);
}

.location-information dd a:hover {
    color: var(--color-primary);
}

.location-details__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 23px;
}

/* =========================================================
   11. REDES SOCIALES Y COMUNIDAD
========================================================= */

.community-section {
    padding-block: 76px 84px;
    background: #111111;
}

.community-section .section-header {
    margin-bottom: 26px;
}

.community-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.7fr 1.05fr;
    grid-template-rows: minmax(125px, 1fr) minmax(85px, 0.65fr);
    gap: 12px;
}

.social-card {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: #303030;
}

.social-card__link {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 15px;
    color: var(--color-white);
}

.social-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 450ms ease;
}

.social-card:hover .social-card__image {
    transform: scale(1.04);
}

.social-card--instagram {
    grid-column: 1;
    grid-row: 1;
    min-height: 170px;
}

.social-card--instagram .social-card__link::after,
.social-card--youtube .social-card__link::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg,
        transparent 15%,
        rgba(0, 0, 0, 0.8)
    );
    content: "";
}

.social-card__platform,
.social-card__handle,
.social-card__stat,
.social-card__description {
    position: relative;
    z-index: 2;
}

.social-card__platform {
    display: inline-block;
    margin-bottom: 7px;
    padding: 4px 7px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.social-card__handle {
    font-size: 11px;
    font-weight: 800;
}

.social-card__description {
    margin: 0;
    color: #bdbdbd;
    font-size: 10px;
    line-height: 1.45;
}

.social-card--tiktok {
    grid-column: 2;
    grid-row: 1;
}

.social-card--tiktok .social-card__link {
    justify-content: center;
}

.social-card__stat {
    margin-bottom: 5px;
    font-family: var(--font-heading);
    font-size: clamp(27px, 3vw, 40px);
    font-weight: 950;
    letter-spacing: -0.05em;
    line-height: 1;
}

.social-card--youtube {
    grid-column: 3;
    grid-row: 1;
    min-height: 170px;
}

.social-card--youtube .social-card__link {
    align-items: flex-start;
}

.social-card--facebook {
    grid-column: 1 / 3;
    grid-row: 2;
}

.social-card--facebook .social-card__link {
    justify-content: center;
    padding: 17px;
}

.social-card--facebook .social-card__platform,
.social-card--whatsapp .social-card__platform {
    margin-bottom: 6px;
    background: transparent;
    font-size: 12px;
}

.social-card--facebook .social-card__description {
    padding-right: 20px;
}

.social-card__arrow {
    position: absolute;
    right: 16px;
    bottom: 15px;
    color: var(--color-primary);
}

.social-card--whatsapp {
    grid-column: 3;
    grid-row: 2;
    background: #eeeeee;
    color: #111111;
}

.social-card--whatsapp .social-card__content {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 14px;
}

.social-card--whatsapp .social-card__platform {
    color: #111111;
}

.social-card--whatsapp .social-card__description {
    margin-bottom: 8px;
    color: #555555;
    font-size: 9px;
}

.social-card--whatsapp .button {
    min-height: 26px;
    padding: 5px 10px;
    background: #111111;
    color: var(--color-white);
}

/* =========================================================
   12. PIE DE PÁGINA
========================================================= */

.site-footer {
    padding-block: 48px 22px;
    background: #090909;
}

.footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.8fr);
    gap: 70px;
    padding-bottom: 38px;
}

.footer-brand {
    max-width: 400px;
}

.footer-brand__logo {
    display: inline-flex;
    width: 145px;
    margin-bottom: 7px;
}

.footer-brand__logo img {
    width: 100%;
    max-height: 55px;
    object-fit: contain;
    object-position: left center;
}

.footer-brand__category {
    margin: 0 0 10px;
    color: #a7a7a7;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.footer-brand__description {
    max-width: 300px;
    margin-bottom: 20px;
    color: #a3a3a3;
    font-size: 11px;
    line-height: 1.6;
}

.footer-heading {
    margin-bottom: 13px;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 950;
    letter-spacing: -0.03em;
    line-height: 1;
    text-transform: uppercase;
}

.footer-contact__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    font-size: 10px;
    font-style: normal;
}

.footer-contact__details a {
    color: #b1b1b1;
}

.footer-contact__details a:hover {
    color: var(--color-primary);
}

.footer-race {
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.footer-race .footer-heading {
    align-self: flex-end;
    width: 100%;
    text-align: right;
}

.footer-race__panel {
    display: flex;
    min-height: 65px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 17px;
    border: 1px solid #383838;
    background: #151515;
}

.footer-race__label {
    color: #aaaaaa;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.footer-race__value {
    color: var(--color-primary);
    font-size: 10px;
    font-weight: 800;
    text-align: right;
    text-transform: uppercase;
}

.footer-race__button {
    width: 100%;
    margin-top: 10px;
}

.footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 18px;
    border-top: 1px solid #292929;
}

.footer-bottom__copyright {
    margin: 0;
    color: #777777;
    font-size: 9px;
}

.footer-bottom__back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #9c9c9c;
    font-size: 9px;
    text-transform: uppercase;
}

.footer-bottom__back-to-top:hover {
    color: var(--color-primary);
}

/* =========================================================
   13. TABLET
   Adaptación para pantallas entre 601px y 1024px
========================================================= */

@media (min-width: 601px) and (max-width: 1024px) {

    :root {
        --page-gutter: clamp(22px, 4vw, 42px);
        --header-height: 66px;
    }

    body {
        font-size: 13px;
    }

    .header-container {
        gap: 18px;
    }

    .brand-logo {
        width: 115px;
        flex-basis: 115px;
    }

    .main-navigation__list {
        gap: clamp(12px, 1.8vw, 20px);
    }

    .main-navigation__link {
        font-size: 9px;
    }

    .header-reservation {
        padding-inline: 12px;
        font-size: 9px;
    }

    .hero {
        min-height: 440px;
        grid-template-columns: minmax(260px, 0.88fr) minmax(0, 1.12fr);
    }

    .hero__content {
        padding-block: 45px 50px;
        padding-right: 18px;
    }

    .hero__title {
        font-size: clamp(39px, 5.5vw, 56px);
    }

    .hero__description {
        max-width: 290px;
        font-size: 11px;
    }

    .hero__visual {
        min-height: 440px;
    }

    .race-status {
        gap: 18px;
        margin-top: 32px;
    }

    .race-status__value {
        font-size: 24px;
    }

    .hero__image-bottom {
        right: 16px;
        bottom: 18px;
        left: 16px;
    }

    .lap-counter__value {
        font-size: 26px;
    }

    .brand-intro {
        min-height: 260px;
        padding-block: 60px;
    }

    .brand-intro__title {
        font-size: clamp(32px, 4.3vw, 44px);
    }

    .brand-intro__description {
        max-width: 500px;
        font-size: 11px;
    }

    .menu-section,
    .events-section,
    .experience-section {
        padding-block: 60px;
    }

    .section-title {
        font-size: clamp(29px, 4vw, 40px);
    }

    .section-header {
        margin-bottom: 22px;
    }

    .section-header__description {
        max-width: 240px;
        font-size: 9px;
    }

    .menu-grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        grid-template-rows: 230px 170px 170px;
        gap: 10px;
    }

    .menu-card--featured {
        grid-column: 1;
        grid-row: 1 / 3;
        min-height: 0;
    }

    .menu-card--beverages {
        grid-column: 2;
        grid-row: 1;
    }

    .menu-card--food {
        grid-column: 2;
        grid-row: 2;
    }

    .menu-card--combo {
        grid-column: 1 / 3;
        grid-row: 3;
        flex-direction: row;
        min-height: 0;
    }

    .menu-card__combo-header {
        min-width: 100px;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 9px;
    }

    .menu-card__combo-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-content: center;
        align-items: center;
        gap: 5px 15px;
        padding: 15px 20px;
    }

    .menu-card--combo .menu-card__title {
        grid-column: 1;
        grid-row: 1;
    }

    .menu-card--combo .menu-card__badge {
        grid-column: 2;
        grid-row: 1;
        margin: 0;
    }

    .menu-card--combo .menu-card__description {
        grid-column: 1;
        grid-row: 2;
        margin: 0;
    }

    .menu-card--combo .button {
        grid-column: 2;
        grid-row: 2;
        margin: 0;
    }

    .events-grid {
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr);
        grid-template-rows: repeat(2, minmax(125px, 1fr));
        gap: 10px;
    }

    .event-card--featured {
        min-height: 260px;
    }

    .event-card--secondary {
        min-height: 125px;
    }

    .event-card__information {
        gap: 10px;
        padding: 12px;
    }

    .event-card--featured .event-card__title {
        font-size: 19px;
    }

    .event-card--featured .button {
        padding-inline: 8px;
        font-size: 8px;
    }

    .experience-grid {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        gap: 30px;
    }

    .experience__title {
        font-size: clamp(35px, 5vw, 49px);
    }

    .experience__visual {
        min-height: 380px;
        gap: 8px;
    }

    .experience__image img {
        min-height: 245px;
    }

    .experience__image--barista {
        margin-top: 75px;
    }

    .experience-quote {
        width: 75%;
        padding: 12px;
    }

    .experience-quote__text {
        font-size: 14px;
    }

    .location-section {
        padding-bottom: 60px;
    }

    .location-card {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .location-map {
        min-height: 300px;
    }

    .location-details {
        padding: 25px;
    }

    .location-details .section-title {
        font-size: 32px;
    }

    .location-details__actions {
        gap: 7px;
    }

    .location-details__actions .button {
        padding-inline: 10px;
        font-size: 9px;
    }

    .community-section {
        padding-block: 60px;
    }

    .community-grid {
        grid-template-columns: 1.1fr 0.8fr;
        grid-template-rows: repeat(3, minmax(115px, auto));
        gap: 10px;
    }

    .social-card--instagram {
        grid-column: 1;
        grid-row: 1;
    }

    .social-card--tiktok {
        grid-column: 2;
        grid-row: 1;
    }

    .social-card--youtube {
        grid-column: 1;
        grid-row: 2;
    }

    .social-card--facebook {
        grid-column: 1;
        grid-row: 3;
    }

    .social-card--whatsapp {
        grid-column: 2;
        grid-row: 2 / 4;
    }

    .footer-main {
        gap: 40px;
    }
}

/* =========================================================
   14. CELULAR
   Adaptación para pantallas de hasta 600px
========================================================= */

@media (max-width: 600px) {

    :root {
        --page-gutter: 15px;
        --header-height: 48px;
    }

    html {
        scroll-padding-top: calc(var(--header-height) + 12px);
    }

    body {
        font-size: 12px;
    }

    .section-container {
        width: calc(100% - 30px);
    }

    .eyebrow {
        gap: 5px;
        margin-bottom: 8px;
        font-size: 7px;
        letter-spacing: 0.09em;
    }

    .status-dot {
        width: 4px;
        height: 4px;
        flex-basis: 4px;
    }

    .section-title {
        font-size: clamp(27px, 7vw, 35px);
        letter-spacing: -0.04em;
    }

    .button {
        min-height: 30px;
        gap: 7px;
        padding: 7px 11px;
        font-size: 9px;
    }

    .text-link {
        font-size: 8px;
    }

    /* Header móvil */

    .site-header {
        position: relative;
    }

    .header-container {
        width: calc(100% - 22px);
        gap: 9px;
    }

    .brand-logo {
        width: 95px;
        flex-basis: 95px;
    }

    .brand-logo__image {
        max-height: 39px;
    }

    .main-navigation {
        position: absolute;
        z-index: 100;
        top: 100%;
        right: 0;
        left: 0;
        display: none;
        align-items: stretch;
        margin: 0;
        padding: 8px 15px 16px;
        border-bottom: 1px solid #333333;
        background: #0a0a0a;
    }

    /*
       El JavaScript de la fase 3 controlará esta clase.
       aria-expanded seguirá siendo el estado accesible del botón.
    */
    .main-navigation.is-open {
        display: flex;
    }

    .main-navigation__list {
        width: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
    }

    .main-navigation__link {
        display: block;
        padding: 12px 5px;
        border-bottom: 1px solid #242424;
        font-size: 10px;
    }

    .main-navigation__link::after {
        display: none;
    }

    .header-reservation {
        min-height: 25px;
        margin-left: auto;
        padding: 6px 10px;
        font-size: 8px;
    }

    .menu-toggle {
        display: flex;
        width: 27px;
        height: 32px;
        flex: 0 0 27px;
        gap: 4px;
        padding: 4px;
    }

    .menu-toggle__line {
        width: 17px;
        height: 1.5px;
    }

    /* Hero móvil */

    .hero {
        display: flex;
        min-height: 0;
        flex-direction: column;
    }

    .hero__content {
        min-height: 206px;
        justify-content: center;
        padding: 20px 15px 17px;
    }

    .hero__eyebrow {
        margin-bottom: 11px;
        font-size: 6px;
    }

    .hero__title {
        max-width: 350px;
        font-size: clamp(34px, 10.4vw, 45px);
        line-height: 0.94;
    }

    .hero__description {
        max-width: 265px;
        margin-top: 9px;
        font-size: 9px;
        line-height: 1.4;
    }

    .hero__actions {
        gap: 8px;
        margin-top: 12px;
    }

    .hero__actions .button {
        min-height: 25px;
        padding: 6px 10px;
        font-size: 8px;
    }

    .race-status {
        width: 100%;
        gap: 21px;
        margin-top: 18px;
    }

    .race-status__item {
        min-width: 42px;
        gap: 3px;
    }

    .race-status__value {
        font-size: 20px;
    }

    .race-status__label {
        font-size: 6px;
        letter-spacing: 0.04em;
    }

    .live-indicator {
        gap: 4px;
        padding: 4px 5px;
        font-size: 10px;
    }

    .hero__microcopy {
        margin-top: 10px;
        font-size: 6px;
    }

    .hero__visual {
        min-height: 245px;
        height: 58vw;
        max-height: 350px;
    }

    .hero__image {
        object-position: center;
    }

    .hero__image-top {
        top: 10px;
        left: 10px;
        gap: 5px;
    }

    .race-tag {
        padding: 4px 6px;
        font-size: 6px;
    }

    .hero__image-bottom {
        right: 10px;
        bottom: 12px;
        left: 10px;
        gap: 8px;
    }

    .finish-label {
        padding: 5px 7px;
        font-size: 12px;
    }

    .finish-label span {
        font-size: 6px;
    }

    .lap-counter__value {
        font-size: 24px;
    }

    .lap-counter__label {
        font-size: 6px;
    }

    .hero__progress {
        height: 2px;
    }

    /* Presentación móvil */

    .brand-intro {
        min-height: 0;
        padding: 47px 16px 43px;
    }

    .brand-intro__eyebrow {
        justify-content: center;
        margin-bottom: 13px;
        font-size: 6px;
    }

    .brand-intro__title {
        font-size: clamp(25px, 7.3vw, 33px);
        line-height: 1.02;
    }

    .brand-intro__title .outlined-text {
        margin-top: 3px;
        -webkit-text-stroke-width: 0.8px;
    }

    .brand-intro__description {
        max-width: 310px;
        margin-top: 14px;
        font-size: 9px;
        line-height: 1.55;
    }

    .race-separator {
        gap: 6px;
        margin-top: 19px;
        font-size: 6px;
    }

    .race-separator__line {
        width: 15px;
    }

    /* Menú móvil */

    .menu-section {
        padding-block: 43px 46px;
    }

    .section-header {
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 19px;
    }

    .section-header .eyebrow {
        font-size: 6px;
    }

    .section-header .section-title {
        font-size: clamp(27px, 7.5vw, 34px);
    }

    .section-header__description {
        max-width: 135px;
        margin-top: 2px;
        font-size: 8px;
        line-height: 1.45;
        text-align: right;
    }

    .menu-grid {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto;
        gap: 9px;
    }

    .menu-card {
        min-height: 0;
    }

    .menu-card--featured {
        grid-column: 1;
        grid-row: auto;
        min-height: 330px;
    }

    .menu-card--beverages {
        grid-column: 1;
        grid-row: auto;
        min-height: 175px;
    }

    .menu-card--food {
        grid-column: 1;
        grid-row: auto;
        min-height: 175px;
    }

    .menu-card--combo {
        grid-column: 1;
        grid-row: auto;
        min-height: 145px;
        flex-direction: row;
    }

    .menu-card__number {
        top: 10px;
        left: 10px;
        font-size: 25px;
    }

    .menu-card__category {
        top: 13px;
        right: 10px;
        font-size: 7px;
    }

    .menu-card__content {
        right: 12px;
        bottom: 12px;
        left: 12px;
        gap: 5px;
    }

    .menu-card__title {
        font-size: 25px;
    }

    .menu-card__description {
        max-width: 220px;
        font-size: 9px;
    }

    .menu-card__content .button {
        min-height: 27px;
        margin-top: 3px;
        font-size: 8px;
    }

    .menu-card--beverages .menu-card__number,
    .menu-card--food .menu-card__number {
        top: 10px;
        left: 10px;
        font-size: 22px;
    }

    .menu-card--beverages .menu-card__category,
    .menu-card--food .menu-card__category {
        top: 13px;
        right: 10px;
        font-size: 7px;
    }

    .menu-card--beverages .menu-card__content,
    .menu-card--food .menu-card__content {
        right: 12px;
        bottom: 11px;
        left: 12px;
    }

    .menu-card--beverages .menu-card__title,
    .menu-card--food .menu-card__title {
        font-size: 22px;
    }

    .menu-card--beverages .menu-card__description,
    .menu-card--food .menu-card__description {
        font-size: 9px;
    }

    .menu-card__combo-header {
        width: 88px;
        min-width: 88px;
        min-height: 0;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 8px;
        padding: 11px 9px;
    }

    .menu-card--combo .menu-card__number {
        font-size: 22px;
    }

    .menu-card--combo .menu-card__category {
        font-size: 7px;
        text-align: left;
    }

    .menu-card__combo-content {
        justify-content: center;
        padding: 13px;
    }

    .menu-card--combo .menu-card__title {
        font-size: 22px;
    }

    .menu-card__badge {
        margin-top: 5px;
        padding: 3px 5px;
        font-size: 6px;
    }

    .menu-card--combo .menu-card__description {
        margin: 7px 0;
        font-size: 9px;
    }

    .menu-card--combo .button {
        min-height: 26px;
        font-size: 8px;
    }

    /* Eventos móvil */

    .events-section {
        padding-block: 43px 38px;
    }

    .events-section .section-header {
        align-items: flex-end;
    }

    .events-section .section-header__description {
        max-width: 125px;
    }

    .events-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: 185px 120px 120px;
        gap: 8px;
    }

    .event-card--featured {
        grid-column: 1 / 3;
        grid-row: 1;
        min-height: 0;
    }

    .event-card--secondary {
        min-height: 0;
    }

    .event-card--secondary:nth-of-type(2) {
        grid-column: 1;
        grid-row: 2;
    }

    .event-card--secondary:nth-of-type(3) {
        grid-column: 2;
        grid-row: 2;
    }

    /*
       El HTML actual tiene dos eventos secundarios.
       El espacio adicional se elimina en la composición
       móvil para evitar una fila vacía.
    */
    .events-grid {
        grid-template-rows: 185px 120px;
    }

    .event-card__tag {
        top: 8px;
        left: 8px;
        padding: 4px 5px;
        font-size: 6px;
    }

    .event-card__tag--outline {
        right: 8px;
        left: auto;
    }

    .event-card__information {
        gap: 8px;
        padding: 10px;
    }

    .event-card__date {
        min-width: 39px;
        padding: 5px;
    }

    .event-card__day {
        font-size: 28px;
    }

    .event-card__month {
        margin-top: 2px;
        font-size: 7px;
    }

    .event-card__details {
        gap: 3px;
    }

    .event-card__location {
        font-size: 6px;
    }

    .event-card__title {
        font-size: 12px;
    }

    .event-card__description {
        font-size: 7px;
    }

    .event-card--featured .event-card__title {
        font-size: 15px;
    }

    .event-card--featured .button {
        min-height: 25px;
        gap: 4px;
        padding: 5px 6px;
        font-size: 7px;
    }

    .event-card--featured .event-card__information {
        flex-wrap: wrap;
    }

    .event-card--featured .event-card__details {
        flex: 1 1 100px;
    }

    .event-card--secondary .event-card__information {
        align-items: center;
        gap: 7px;
        padding: 8px;
    }

    .event-card--secondary .event-card__date {
        min-width: 33px;
        padding: 5px 3px;
    }

    .event-card--secondary .event-card__day {
        font-size: 23px;
    }

    .event-card--secondary .event-card__title {
        font-size: 10px;
    }

    .events-footer {
        align-items: flex-start;
        gap: 9px;
        margin-top: 12px;
        padding: 10px;
    }

    .events-footer__note {
        max-width: 210px;
        font-size: 7px;
    }

    .events-footer .text-link {
        flex: 0 0 auto;
        font-size: 7px;
    }

    /* Experiencia móvil */

    .experience-section {
        padding-block: 44px 45px;
    }

    .experience-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 25px;
    }

    .experience__title {
        gap: 4px;
        margin-top: 13px;
        font-size: clamp(37px, 10vw, 47px);
    }

    .experience__description {
        max-width: 320px;
        margin-top: 16px;
        font-size: 10px;
        line-height: 1.55;
    }

    .coffee-specs {
        gap: 25px;
        margin-top: 22px;
    }

    .coffee-spec__value {
        font-size: 23px;
    }

    .coffee-spec__label {
        font-size: 7px;
    }

    .experience__brand-mark {
        width: 115px;
        margin-top: 22px;
    }

    .experience__visual {
        min-height: 310px;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 8px;
        padding-bottom: 25px;
    }

    .experience__image img {
        min-height: 220px;
    }

    .experience__image--machine img {
        aspect-ratio: 0.75;
    }

    .experience__image--barista {
        margin-top: 65px;
    }

    .experience__image--barista img {
        aspect-ratio: 0.72;
    }

    .experience-quote {
        right: 0;
        bottom: 0;
        width: min(205px, 72%);
        padding: 11px;
    }

    .experience-quote__label {
        margin-bottom: 5px;
        font-size: 8px;
    }

    .experience-quote__text {
        margin-bottom: 5px;
        font-size: 13px;
    }

    .experience-quote__author {
        font-size: 6px;
    }

    /* Ubicación móvil */

    .location-section {
        padding-block: 0 43px;
    }

    .location-card {
        grid-template-columns: minmax(0, 1fr);
    }

    .location-map {
        min-height: 195px;
        height: 55vw;
        max-height: 260px;
    }

    .location-map__label,
    .location-map__status {
        padding: 5px 7px;
        font-size: 7px;
    }

    .location-details {
        padding: 20px 16px;
    }

    .location-details .eyebrow {
        font-size: 6px;
    }

    .location-details .section-title {
        font-size: 29px;
    }

    .location-details__intro {
        margin: 8px 0 15px;
        font-size: 9px;
    }

    .location-information {
        gap: 10px;
    }

    .location-information__item {
        padding-top: 9px;
    }

    .location-information dt {
        font-size: 8px;
    }

    .location-information dd {
        font-size: 9px;
    }

    .location-details__actions {
        width: 100%;
        gap: 7px;
        margin-top: 17px;
    }

    .location-details__actions .button {
        flex: 1;
        padding-inline: 8px;
        font-size: 8px;
    }

    /* Comunidad móvil */

    .community-section {
        padding-block: 42px 43px;
    }

    .community-section .section-header {
        align-items: flex-end;
        gap: 8px;
        margin-bottom: 18px;
    }

    .community-section .section-title {
        font-size: clamp(23px, 6.5vw, 30px);
    }

    .community-section .section-header__description {
        max-width: 130px;
        font-size: 7px;
    }

    .community-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: 135px 110px 110px;
        gap: 8px;
    }

    .social-card--instagram {
        grid-column: 1 / 3;
        grid-row: 1;
        min-height: 0;
    }

    .social-card--tiktok {
        grid-column: 1;
        grid-row: 2;
    }

    .social-card--youtube {
        grid-column: 2;
        grid-row: 2 / 4;
        min-height: 0;
    }

    .social-card--facebook {
        grid-column: 1;
        grid-row: 3;
    }

    .social-card--whatsapp {
        display: none;
    }

    .social-card__link {
        padding: 10px;
    }

    .social-card__platform {
        margin-bottom: 5px;
        padding: 3px 5px;
        font-size: 7px;
    }

    .social-card__handle {
        font-size: 9px;
    }

    .social-card__description {
        font-size: 8px;
    }

    .social-card__stat {
        font-size: 30px;
    }

    .social-card--facebook .social-card__link {
        padding: 10px;
    }

    .social-card--facebook .social-card__platform {
        padding: 0;
        background: transparent;
        font-size: 10px;
    }

    .social-card__arrow {
        right: 9px;
        bottom: 9px;
    }

    /* Pie de página móvil */

    .site-footer {
        padding-block: 31px 16px;
    }

    .footer-main {
        grid-template-columns: minmax(0, 1fr);
        gap: 26px;
        padding-bottom: 23px;
    }

    .footer-brand__logo {
        width: 120px;
    }

    .footer-brand__category {
        font-size: 8px;
    }

    .footer-brand__description {
        max-width: 280px;
        margin-bottom: 15px;
        font-size: 9px;
    }

    .footer-heading {
        margin-bottom: 9px;
        font-size: 17px;
    }

    .footer-contact__details {
        gap: 6px;
        font-size: 9px;
    }

    .footer-race .footer-heading {
        text-align: left;
    }

    .footer-race__panel {
        min-height: 49px;
        padding: 10px;
    }

    .footer-race__label,
    .footer-race__value {
        font-size: 8px;
    }

    .footer-race__button {
        min-height: 33px;
        margin-top: 8px;
    }

    .footer-bottom {
        align-items: flex-start;
        gap: 10px;
        padding-top: 13px;
    }

    .footer-bottom__copyright {
        max-width: 235px;
        font-size: 7px;
        line-height: 1.5;
    }

    .footer-bottom__back-to-top {
        flex: 0 0 auto;
        gap: 4px;
        font-size: 7px;
    }
}

/* =========================================================
   15. PANTALLAS MUY PEQUEÑAS
========================================================= */

@media (max-width: 360px) {

    :root {
        --page-gutter: 12px;
    }

    .header-container {
        width: calc(100% - 18px);
        gap: 6px;
    }

    .brand-logo {
        width: 83px;
        flex-basis: 83px;
    }

    .header-reservation {
        padding-inline: 8px;
        font-size: 7px;
    }

    .hero__title {
        font-size: 33px;
    }

    .race-status {
        gap: 15px;
    }

    .section-header__description {
        max-width: 120px;
        font-size: 7px;
    }

    .menu-card--featured {
        min-height: 285px;
    }

    .menu-card__combo-header {
        width: 72px;
        min-width: 72px;
        padding-inline: 7px;
    }

    .menu-card--combo .menu-card__title {
        font-size: 19px;
    }

    .events-grid {
        grid-template-rows: 170px 112px;
    }

    .event-card--featured .button {
        padding-inline: 5px;
        font-size: 6px;
    }

    .experience__title {
        font-size: 36px;
    }

    .community-grid {
        grid-template-rows: 120px 100px 100px;
    }
}

/* =========================================================
   16. REDUCCIÓN DE MOVIMIENTO
========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
